<?xml version="1.0"?>
<ruleset name="WP ERP">
    <description>Security, PHP compatibility and translation checks for WP ERP.</description>

    <!--
        Formatting rules are left out on purpose. The code base predates them
        (26,000+ findings, most of them array syntax and indentation), so they
        failed every pull request and hid the findings that matter. What is left
        is what causes a vulnerability, a fatal error on a supported PHP version,
        or a broken translation.

        The pull request check reports a finding only on a line the pull request
        changes: see .github/workflows/phpcs.yml.
    -->

    <!-- What to scan -->
    <file>.</file>
    <exclude-pattern>*/.github/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>
    <exclude-pattern>*/i18n/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/bin/*</exclude-pattern>

    <!-- How to scan -->
    <arg value="sp"/>
    <arg name="basepath" value="./"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>

    <!-- PHP compatibility: readme.txt "Requires PHP: 7.4" -->
    <config name="testVersion" value="7.4-"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- readme.txt "Requires at least: 5.6" -->
    <config name="minimum_supported_wp_version" value="5.6"/>

    <!-- Syntax errors -->
    <rule ref="Generic.PHP.Syntax"/>

    <!-- Security: escaping, nonces, input handling, redirects -->
    <rule ref="WordPress.Security">
        <!-- An exception message is escaped where it is printed, not where it is thrown. -->
        <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
    </rule>

    <!-- Security: SQL injection -->
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>

    <!-- Loose in_array() has let the wrong role or status through before. -->
    <rule ref="WordPress.PHP.StrictInArray"/>
    <rule ref="WordPress.PHP.StrictInArray.MissingTrueStrict">
        <type>error</type>
    </rule>

    <!-- Functions that must not ship -->
    <rule ref="WordPress.PHP.NoSilencedErrors"/>
    <rule ref="WordPress.PHP.RestrictedPHPFunctions"/>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
    <rule ref="WordPress.WP.DeprecatedFunctions"/>
    <rule ref="WordPress.WP.DeprecatedParameters"/>
    <rule ref="WordPress.WP.DeprecatedClasses"/>

    <!-- Translations -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="erp"/>
            </property>
        </properties>
    </rule>
</ruleset>
