{
    "name": "wp-erp-playwright-tests",
    "version": "1.0.0",
    "description": "End-to-end and API test automation suite for WP ERP (free) + ERP Pro using Playwright",
    "private": true,
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/wp-erp/wp-erp.git",
        "directory": "tests/pw"
    },
    "author": {
        "name": "weDevs",
        "email": "support@wedevs.com",
        "url": "https://wedevs.com"
    },
    "license": "GPL-2.0-or-later",
    "scripts": {
        "install:chromium": "playwright install --with-deps chromium",
        "fix:env-lock": "find \"$HOME/.wp-env\" -name '*.lock' -delete 2>/dev/null; exit 0",
        "start:env": "wp-env start || (npm run fix:env-lock && sleep 10 && wp-env start)",
        "stop:env": "wp-env stop",
        "restart:env": "npm run stop:env && npm run start:env",
        "reset:env": "wp-env destroy --scripts false && npm run start:env",
        "wp-env": "wp-env",
        "cli": "wp-env run cli wp",
        "setup": "npx playwright test --project=site_setup --project=auth_setup --project=env_setup",
        "harness": "node bin/harness-report.mjs",
        "test": "npx playwright test --project=e2e_tests --project=accounting_money",
        "test:e2e": "NO_SETUP=true npx playwright test --project=e2e_tests",
        "test:tier1": "NO_SETUP=true npx playwright test --project=e2e_tests --grep @tier1",
        "test:tier2": "NO_SETUP=true npx playwright test --project=e2e_tests --grep @tier2",
        "test:tier3": "NO_SETUP=true npx playwright test --project=e2e_tests --grep @tier3",
        "test:api": "npx playwright test --config=api.config.ts",
        "test:license-limit": "npx playwright test --project=license_limit --workers=1",
        "test:headed": "NO_SETUP=true npx playwright test --project=e2e_tests --headed",
        "test:ui": "NO_SETUP=true npx playwright test --project=e2e_tests --ui",
        "test:debug": "NO_SETUP=true npx playwright test --project=e2e_tests --debug",
        "test:report": "npx playwright show-report playwright-report/e2e/html-report",
        "teardown:license": "npx playwright test --config=teardown.config.ts",
        "type:check": "npx tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --check",
        "format:fix": "prettier . --write"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "@typescript-eslint/eslint-plugin": "^8.26.1",
        "@typescript-eslint/parser": "^8.26.1",
        "eslint": "^9.22.0",
        "eslint-config-prettier": "^10.1.1",
        "eslint-plugin-playwright": "^2.10.4",
        "prettier": "^3.5.3",
        "tsx": "^4.19.3",
        "typescript": "^5.8.2"
    },
    "dependencies": {
        "@faker-js/faker": "^9.5.1",
        "@playwright/test": "^1.51.0",
        "@wordpress/env": "^10.20.0",
        "dotenv": "^16.4.7",
        "mysql2": "^3.13.0",
        "php-serialize": "^5.1.2",
        "zod": "^3.24.2"
    }
}
